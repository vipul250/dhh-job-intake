# Copy this file to .env for local dev (npm run dev).
# On Vercel, set these same two under Project Settings -> Environment Variables
# instead of uploading this file.

# Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Supabase -> Project Settings -> API -> Project API keys -> anon / public
# This key is meant to be public (it ends up in the browser bundle either way).
# Row Level Security policies in supabase/schema.sql are what actually gate access.
VITE_SUPABASE_ANON_KEY=

# NOT prefixed with VITE_ — this one stays server-side only, used by
# api/parse.js. Set this in Vercel's env vars, not in a browser-shipped .env.
# Get one from https://console.anthropic.com/settings/keys (pay-as-you-go,
# separate from your claude.ai login).
ANTHROPIC_API_KEY=
